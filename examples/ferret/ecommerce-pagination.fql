LET baseUrl = @baseUrl
LET page1 = DOCUMENT(baseUrl + "/scenarios/ecommerce/products/")
LET page2 = DOCUMENT(baseUrl + "/scenarios/ecommerce/products/page/2/")

RETURN {
    page1Count: ELEMENTS_COUNT(page1, "[data-testid='product-card']"),
    page2Count: ELEMENTS_COUNT(page2, "[data-testid='product-card']")
}
