LET baseUrl = @baseUrl
LET doc = DOCUMENT(baseUrl + "/scenarios/tables/orders/")

FOR row IN ELEMENTS(doc, "#sortable-orders tbody tr")
    RETURN {
        orderId: INNER_TEXT(row, "td:nth-child(1)"),
        status: INNER_TEXT(row, "td:nth-child(4)"),
        total: INNER_TEXT(row, "td:nth-child(5)")
    }
