LET baseUrl = @baseUrl
LET page = DOCUMENT(baseUrl + "/scenarios/dynamic-products/delayed/", { driver: "cdp" })

WAIT_ELEMENT(page, "[data-testid='dynamic-products-scenario'][data-state='loaded']")

RETURN {
    status: TRIM(INNER_TEXT(page, "[data-testid='dynamic-products-status']")),
    products: ELEMENTS_COUNT(page, "[data-testid='dynamic-product-card']")
}
