LET baseUrl = @baseUrl
LET doc = DOCUMENT(baseUrl + "/scenarios/ecommerce/products/")

RETURN ELEMENTS(doc, "[data-testid='product-card']")
  |> MAP({
    id: ATTRIBUTE(@, "data-product-id"),
    title: INNER_TEXT(ELEMENT(@, "[data-testid='product-title']")),
    price: ATTRIBUTE(ELEMENT(@, "[data-testid='product-price']"), "data-price")
  })
