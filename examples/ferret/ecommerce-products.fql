LET baseUrl = @baseUrl
LET doc = DOCUMENT(baseUrl + "/scenarios/ecommerce/products/")

FOR card IN ELEMENTS(doc, "[data-testid='product-card']")
    LET price = ELEMENT(card, "[data-testid='product-price']")

    RETURN {
        id: card.attributes["data-product-id"],
        title: TRIM(INNER_TEXT(card, "[data-testid='product-title']")),
        price: TO_FLOAT(price.attributes["data-price"]),
        currency: price.attributes["data-currency"]
    }
