LET baseUrl = @baseUrl
LET doc = DOCUMENT(baseUrl + "/scenarios/messy-markup/")

FOR card IN ELEMENTS(doc, ".product-card")
    LET dataName = ELEMENT(card, "[data-testid='product-name']")?
    LET heading = ELEMENT(card, "h2")?
    LET title = ELEMENT(card, ".title")?
    LET price = ELEMENT(card, ".price")?
    LET money = ELEMENT(card, ".money")?

    RETURN {
        title: TRIM(dataName != NONE ? INNER_TEXT(dataName) : heading != NONE ? INNER_TEXT(heading) : title != NONE ? INNER_TEXT(title) : "MISSING"),
        price: TRIM(price != NONE ? INNER_TEXT(price) : money != NONE ? INNER_TEXT(money) : "MISSING")
    }
