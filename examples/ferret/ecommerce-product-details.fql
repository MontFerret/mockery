LET baseUrl = @baseUrl
LET doc = DOCUMENT(baseUrl + "/scenarios/ecommerce/products/laptop-pro-14/")
LET price = ELEMENT(doc, "[data-testid='product-price']")

RETURN {
    title: TRIM(INNER_TEXT(doc, "[data-testid='product-title']")),
    price: TO_FLOAT(price.attributes["data-price"]),
    currency: price.attributes["data-currency"],
    specsRows: ELEMENTS_COUNT(doc, "[data-testid='product-specs'] tr"),
    reviews: ELEMENTS_COUNT(doc, "[data-testid='review']")
}
