LET baseUrl = @baseUrl
LET doc = DOCUMENT(baseUrl + "/scenarios/network/delayed-requests/")

WAITFOR VALUE (
  FIRST(QUERY "[data-testid='network-scenario']" IN doc USING css)
    .attributes["data-state"] == "complete"
)
TIMEOUT 10s

RETURN {
  delays: FIRST(QUERY "[data-testid='network-delay-config']" IN doc USING css).attributes,
  requestCount: FIRST(QUERY "[data-testid='network-scenario']" IN doc USING css).attributes["data-request-count"],
  requests: (
    QUERY "[data-event='request-started']" IN doc USING css
  )[* RETURN .attributes["data-request-id"]]
}
