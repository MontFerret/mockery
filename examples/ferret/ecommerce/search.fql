LET baseUrl = @baseUrl
LET page = DOCUMENT(baseUrl + "/scenarios/ecommerce/search/", { driver: "cdp" })

WAIT_ELEMENT(page, "[data-testid='product-card']")
INPUT(page, "[data-testid='search-query']", "laptop")
CLICK(page, "[data-testid='search-in-stock']")
CLICK(page, "[data-testid='search-submit']")

WAIT_ELEMENT(page, "[data-testid='search-loader'][data-state='loading']:not([hidden])")
WAIT_ELEMENT(page, "[data-testid='search-results'][data-state='loading'][hidden]")

LET loadingStatus = TRIM(INNER_TEXT(page, "[data-testid='search-status']"))
LET hiddenResults = ELEMENTS_COUNT(page, "[data-testid='search-results'][hidden]")

WAITFOR (
    TRIM(INNER_TEXT(page, "[data-testid='search-status']")) == "27 products found"
)
TIMEOUT 10s

WAIT_ELEMENT(page, "[data-testid='search-results'][data-state='ready']:not([hidden])")

RETURN {
    status: TRIM(INNER_TEXT(page, "[data-testid='search-status']")),
    results: ELEMENTS_COUNT(page, "[data-testid='search-results'] [data-testid='product-card']"),
    loading: {
        status: loadingStatus,
        hiddenResults: hiddenResults,
        loaderState: ELEMENT(page, "[data-testid='search-loader']").attributes["data-state"],
        resultsState: ELEMENT(page, "[data-testid='search-results']").attributes["data-state"]
    }
}
