LET baseUrl = @baseUrl
LET browser = BROWSER()
LET page = PAGE(browser)
NAVIGATE(page, baseUrl + "/scenarios/forms/")
TYPE(page, "#email", "demo@example.com")
CLICK(page, "#newsletter-form button[type='submit']")
WAITFOR ELEMENT(page, "#form-result:not([hidden])")

RETURN INNER_TEXT(ELEMENT(page, "#form-result"))
