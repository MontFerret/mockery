---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { categories, products } from '../../../lib/site.js';

const brands = Array.from(new Set(products.map((product) => product.brand))).sort((a, b) => a.localeCompare(b));
---
<BaseLayout title="E-commerce Search" description="Client-side e-commerce search and filters." canonicalPath="/scenarios/ecommerce/search/">
  <h1>Search products</h1>
  <form id="product-search-form" data-testid="product-search-form">
    <label for="search-query">Search</label>
    <input id="search-query" data-testid="search-query" name="q" type="search" autocomplete="off" />

    <label for="search-category">Category</label>
    <select id="search-category" data-testid="search-category" name="category">
      <option value="">All categories</option>
      {categories.map((category) => <option value={category.id}>{category.name}</option>)}
    </select>

    <label for="search-brand">Brand</label>
    <select id="search-brand" data-testid="search-brand" name="brand">
      <option value="">All brands</option>
      {brands.map((brand) => <option value={brand}>{brand}</option>)}
    </select>

    <label for="search-min-price">Minimum price</label>
    <input id="search-min-price" data-testid="search-min-price" name="minPrice" type="number" min="0" step="0.01" />

    <label for="search-max-price">Maximum price</label>
    <input id="search-max-price" data-testid="search-max-price" name="maxPrice" type="number" min="0" step="0.01" />

    <label class="checkbox-row">
      <input id="search-in-stock" data-testid="search-in-stock" name="inStock" type="checkbox" />
      In stock only
    </label>

    <label for="search-sort">Sort</label>
    <select id="search-sort" data-testid="search-sort" name="sort">
      <option value="name">Name</option>
      <option value="price-asc">Price ascending</option>
      <option value="price-desc">Price descending</option>
      <option value="rating">Rating</option>
    </select>

    <button data-testid="search-submit" type="submit">Search</button>
  </form>

  <div id="search-status" data-testid="search-status" aria-live="polite">Loading products...</div>
  <div
    id="search-results"
    class="product-grid"
    data-testid="search-results"
    data-hover-delay-ms="500"
  ></div>

  <template id="product-hover-preview-template">
    <section
      class="product-hover-preview"
      data-testid="product-hover-preview"
      data-state="idle"
      data-review-count="0"
      aria-live="polite"
      hidden
    >
      <span
        class="product-hover-loader"
        data-testid="product-hover-loader"
        aria-hidden="true"
        hidden
      ></span>
      <p class="product-hover-status" data-testid="product-hover-status">Hover to load reviews.</p>
      <div class="product-hover-content"></div>
    </section>
  </template>

  <template id="product-hover-review-template">
    <article class="product-hover-review" data-testid="product-hover-review">
      <h3 class="product-hover-review-title"></h3>
      <p class="product-hover-review-author"></p>
      <p class="product-hover-review-stars"></p>
    </article>
  </template>

  <script>
    const form = document.getElementById('product-search-form');
    const status = document.getElementById('search-status');
    const results = document.getElementById('search-results');
    const previewTemplate = document.getElementById('product-hover-preview-template');
    const reviewTemplate = document.getElementById('product-hover-review-template');
    const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
    const hoverDelayMs = Number(results.dataset.hoverDelayMs || 500);
    const reviewStates = new Map();
    let products = [];

    const resolvePath = (pathname) => {
      if (window.Mockery?.resolvePath) {
        return window.Mockery.resolvePath(pathname);
      }

      const basePath = document.documentElement.dataset.basePath || '/';
      const clean = String(pathname).replace(/^\/+/, '');
      return new URL(`${basePath}${clean}`, window.location.origin).toString();
    };

    const normalize = (value) => String(value ?? '').trim().toLowerCase();
    const delay = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
    const numberOrNull = (value) => {
      if (String(value ?? '').trim() === '') {
        return null;
      }

      const parsed = Number(value);
      return Number.isFinite(parsed) ? parsed : null;
    };

    const productMatches = (product, values) => {
      const query = normalize(values.get('q'));
      const minPrice = numberOrNull(values.get('minPrice'));
      const maxPrice = numberOrNull(values.get('maxPrice'));

      if (query) {
        const haystack = normalize(`${product.title} ${product.brand} ${product.category} ${product.sku} ${(product.tags ?? []).join(' ')}`);
        if (!haystack.includes(query)) {
          return false;
        }
      }

      if (values.get('category') && product.category !== values.get('category')) {
        return false;
      }

      if (values.get('brand') && product.brand !== values.get('brand')) {
        return false;
      }

      if (minPrice !== null && product.price < minPrice) {
        return false;
      }

      if (maxPrice !== null && product.price > maxPrice) {
        return false;
      }

      if (values.get('inStock') === 'on' && !product.inStock) {
        return false;
      }

      return true;
    };

    const sortProducts = (items, sort) => {
      const sorted = [...items];

      if (sort === 'price-asc') {
        sorted.sort((a, b) => a.price - b.price || a.title.localeCompare(b.title));
      } else if (sort === 'price-desc') {
        sorted.sort((a, b) => b.price - a.price || a.title.localeCompare(b.title));
      } else if (sort === 'rating') {
        sorted.sort((a, b) => (b.rating ?? -1) - (a.rating ?? -1) || a.title.localeCompare(b.title));
      } else {
        sorted.sort((a, b) => a.title.localeCompare(b.title));
      }

      return sorted;
    };

    const reviewState = (productId) => {
      if (!reviewStates.has(productId)) {
        reviewStates.set(productId, {
          status: 'idle',
          requestCount: 0,
          payload: null,
          promise: null,
        });
      }

      return reviewStates.get(productId);
    };

    const loadReviews = (productId) => {
      const state = reviewState(productId);

      if (state.status === 'loaded') {
        return Promise.resolve(state.payload);
      }

      if (state.promise) {
        return state.promise;
      }

      state.status = 'loading';
      state.requestCount += 1;

      const request = fetch(resolvePath(`/api/reviews/${encodeURIComponent(productId)}.json`))
        .then((response) => {
          if (!response.ok) {
            throw new Error(`Review request failed with status ${response.status}`);
          }

          return response.json();
        })
        .then(
          (payload) => ({ payload }),
          (error) => ({ error }),
        );

      state.promise = Promise.all([request, delay(hoverDelayMs)])
        .then(([result]) => {
          if (result.error) {
            throw result.error;
          }

          state.status = 'loaded';
          state.payload = result.payload;
          return state.payload;
        })
        .catch((error) => {
          state.status = 'error';
          state.payload = null;
          throw error;
        })
        .finally(() => {
          state.promise = null;
        });

      return state.promise;
    };

    const productCard = (product) => {
      const article = document.createElement('article');
      const state = reviewState(product.id);
      article.className = 'product-card';
      article.dataset.testid = 'product-card';
      article.dataset.productId = product.id;
      article.dataset.productSku = product.sku;
      article.dataset.category = product.category;
      article.dataset.brand = product.brand;
      article.dataset.price = String(product.price);
      article.dataset.inStock = String(product.inStock);
      article.dataset.hovered = 'false';
      article.dataset.hoverState = state.status;
      article.dataset.hoverRequestCount = String(state.requestCount);

      const link = document.createElement('a');
      link.className = 'product-link';
      link.dataset.testid = 'product-link';
      link.href = product.url;

      const image = document.createElement('img');
      image.className = 'product-image';
      image.dataset.testid = 'product-image';
      image.src = product.image;
      image.alt = `${product.title} product image`;
      image.loading = 'lazy';

      const title = document.createElement('h2');
      title.className = 'product-title';
      title.dataset.testid = 'product-title';
      title.textContent = product.title;

      const brand = document.createElement('p');
      brand.className = 'product-brand';
      brand.dataset.testid = 'product-brand';
      brand.textContent = product.brand;

      const price = document.createElement('p');
      price.className = 'product-price';
      price.dataset.testid = 'product-price';
      price.dataset.price = String(product.price);
      price.dataset.currency = product.currency;
      price.textContent = money.format(product.price);

      const rating = document.createElement('p');
      rating.className = 'product-rating';
      rating.dataset.testid = 'product-rating';
      rating.dataset.rating = product.rating ?? '';
      rating.textContent = product.rating ? `${product.rating} out of 5` : 'No reviews yet';

      const stock = document.createElement('p');
      stock.className = 'product-stock';
      stock.dataset.testid = 'product-stock';
      stock.dataset.stockCount = String(product.stockCount);
      stock.textContent = product.inStock ? 'In stock' : 'Out of stock';

      const preview = previewTemplate.content.firstElementChild.cloneNode(true);
      const hoverStatus = preview.querySelector('[data-testid="product-hover-status"]');
      const loader = preview.querySelector('[data-testid="product-hover-loader"]');
      const hoverContent = preview.querySelector('.product-hover-content');

      link.append(image, title);
      article.append(link, brand, price);

      if (product.oldPrice) {
        const oldPrice = document.createElement('p');
        oldPrice.className = 'product-old-price old-price';
        oldPrice.dataset.testid = 'product-old-price';
        oldPrice.dataset.price = String(product.oldPrice);
        oldPrice.textContent = money.format(product.oldPrice);
        article.append(oldPrice);
      }

      const renderReviewState = () => {
        article.dataset.hoverState = state.status;
        article.dataset.hoverRequestCount = String(state.requestCount);
        preview.dataset.state = state.status;
        loader.hidden = state.status !== 'loading';
        hoverContent.replaceChildren();

        if (state.status === 'loading') {
          hoverStatus.textContent = 'Loading reviews...';
          preview.dataset.reviewCount = '0';
          return;
        }

        if (state.status === 'error') {
          hoverStatus.textContent = 'Reviews could not be loaded.';
          preview.dataset.reviewCount = '0';
          return;
        }

        if (state.status !== 'loaded') {
          hoverStatus.textContent = 'Hover to load reviews.';
          preview.dataset.reviewCount = '0';
          return;
        }

        const reviews = state.payload?.items ?? [];
        preview.dataset.reviewCount = String(reviews.length);

        if (reviews.length === 0) {
          hoverStatus.textContent = 'No reviews found.';
          return;
        }

        hoverStatus.textContent = `${reviews.length} review${reviews.length === 1 ? '' : 's'} loaded.`;

        const review = reviews[0];
        const reviewArticle = reviewTemplate.content.firstElementChild.cloneNode(true);
        reviewArticle.dataset.reviewId = review.id;
        reviewArticle.dataset.stars = String(review.stars);

        const reviewTitle = reviewArticle.querySelector('.product-hover-review-title');
        reviewTitle.textContent = review.title;

        const reviewAuthor = reviewArticle.querySelector('.product-hover-review-author');
        reviewAuthor.textContent = review.author;

        const reviewStars = reviewArticle.querySelector('.product-hover-review-stars');
        reviewStars.textContent = `${review.stars} out of 5`;

        hoverContent.append(reviewArticle);
      };

      article.append(rating, stock, preview);
      renderReviewState();

      article.addEventListener('mouseenter', async () => {
        article.dataset.hovered = 'true';
        preview.hidden = false;

        if (state.status === 'loaded') {
          renderReviewState();
          return;
        }

        const request = loadReviews(product.id);
        renderReviewState();

        try {
          await request;
        } catch {
          // The visible error state is retryable on the next hover.
        }

        renderReviewState();
      });

      article.addEventListener('mouseleave', () => {
        article.dataset.hovered = 'false';
        preview.hidden = true;
      });

      return article;
    };

    const render = () => {
      const values = new FormData(form);
      const filtered = sortProducts(products.filter((product) => productMatches(product, values)), values.get('sort'));

      results.replaceChildren(...filtered.map(productCard));
      status.textContent = `${filtered.length} product${filtered.length === 1 ? '' : 's'} found`;
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      render();
    });

    fetch(resolvePath('/api/search/products.json'))
      .then((response) => response.json())
      .then((payload) => {
        products = payload.items;
        render();
      })
      .catch(() => {
        status.textContent = 'Search data could not be loaded.';
      });
  </script>
</BaseLayout>
