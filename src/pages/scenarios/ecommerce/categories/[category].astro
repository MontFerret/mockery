---
import ProductCard from '../../../../components/ProductCard.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { categories, products } from '../../../../lib/site.js';

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.id },
    props: {
      category,
      items: products.filter((product) => product.category === category.id),
    },
  }));
}

const { category, items } = Astro.props;
---
<BaseLayout title={`${category.name} Category`} description={`Category page for ${category.name}.`} canonicalPath={`/scenarios/ecommerce/categories/${category.id}/`}>
  <section class="category-header" data-testid="category-header" data-category={category.id}>
    <h1>{category.name}</h1>
    <p>{category.description}</p>
    <p data-testid="category-count">{items.length} products</p>
  </section>
  <div class="product-grid">
    {items.map((product) => <ProductCard product={product} />)}
  </div>
</BaseLayout>
