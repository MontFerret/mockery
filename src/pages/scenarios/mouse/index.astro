---
import mouseActionsScript from '../../../assets/mouse-actions.js?url';
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Mouse Actions Scenario"
  description="Deterministic mouse hover, movement, button, and click scenarios."
  canonicalPath="/scenarios/mouse/"
  scripts={[mouseActionsScript]}
  mainId="mouse-scenario"
  mainClass="wrap scenario mouse-scenario"
  mainAttributes={{
    'data-testid': 'mouse-scenario',
    'data-scenario': 'mouse',
    'data-state': 'idle',
    'data-event-count': '0',
    'data-last-event': 'none',
    'data-last-target': 'none',
    'data-mouse-x': '0',
    'data-mouse-y': '0',
  }}
>
  <header class="scenario-header">
    <h1>Mouse Actions</h1>
    <p class="lead">
      Deterministic targets for hover, movement, mouse buttons, and click assertions.
    </p>
  </header>

  <div class="mouse-grid">
    <section
      id="mouse-hover-case"
      class="mouse-case card"
      data-testid="mouse-hover-case"
      data-hovered="false"
      data-enter-count="0"
      data-leave-count="0"
      data-over-count="0"
      data-out-count="0"
    >
      <h2>Hover and leave</h2>
      <p>Hover the primary target to change its color, then move to the neutral target.</p>
      <div class="mouse-target-row">
        <button
          id="mouse-hover-target"
          class="mouse-action-target mouse-hover-target"
          data-testid="mouse-hover-target"
          type="button"
          aria-describedby="mouse-hover-status"
        >
          Hover me
        </button>
        <button
          id="mouse-hover-away-target"
          class="mouse-action-target mouse-away-target"
          data-testid="mouse-hover-away-target"
          type="button"
        >
          Move here to leave
        </button>
      </div>
      <p
        id="mouse-hover-status"
        class="mouse-status"
        data-testid="mouse-hover-status"
        data-state="idle"
        aria-live="polite"
      >
        Not hovered.
      </p>
    </section>

    <section
      id="mouse-move-case"
      class="mouse-case card"
      data-testid="mouse-move-case"
      data-x="0"
      data-y="0"
      data-move-count="0"
    >
      <h2>Viewport movement</h2>
      <p>Every mouse move records its viewport coordinates for exact assertions.</p>
      <div
        id="mouse-move-target"
        class="mouse-move-target"
        data-testid="mouse-move-target"
        aria-describedby="mouse-move-status"
      >
        Move anywhere in the viewport
      </div>
      <p
        id="mouse-move-status"
        class="mouse-status"
        data-testid="mouse-move-status"
        aria-live="polite"
      >
        Position: x=0, y=0. Moves: 0.
      </p>
    </section>

    <section
      id="mouse-press-case"
      class="mouse-case card"
      data-testid="mouse-press-case"
      data-state="idle"
      data-down-count="0"
      data-up-count="0"
      data-last-button="none"
    >
      <h2>Mouse down and up</h2>
      <p>Press and release can be asserted independently through the target state.</p>
      <button
        id="mouse-press-target"
        class="mouse-action-target mouse-press-target"
        data-testid="mouse-press-target"
        type="button"
        aria-describedby="mouse-press-status"
      >
        Press and release
      </button>
      <p
        id="mouse-press-status"
        class="mouse-status"
        data-testid="mouse-press-status"
        data-state="idle"
        aria-live="polite"
      >
        State: idle.
      </p>
    </section>

    <section
      id="mouse-click-case"
      class="mouse-case card"
      data-testid="mouse-click-case"
      data-click-count="0"
      data-last-button="none"
    >
      <h2>Single click</h2>
      <p>A regular click increments an isolated counter.</p>
      <button
        id="mouse-click-target"
        class="mouse-action-target"
        data-testid="mouse-click-target"
        type="button"
        aria-describedby="mouse-click-status"
      >
        Click once
      </button>
      <p
        id="mouse-click-status"
        class="mouse-status"
        data-testid="mouse-click-status"
        aria-live="polite"
      >
        Clicks: 0.
      </p>
    </section>

    <section
      id="mouse-double-click-case"
      class="mouse-case card"
      data-testid="mouse-double-click-case"
      data-double-click-count="0"
      data-last-button="none"
    >
      <h2>Double click</h2>
      <p>A double-click event increments its own counter without sharing the single-click target.</p>
      <button
        id="mouse-double-click-target"
        class="mouse-action-target"
        data-testid="mouse-double-click-target"
        type="button"
        aria-describedby="mouse-double-click-status"
      >
        Double-click me
      </button>
      <p
        id="mouse-double-click-status"
        class="mouse-status"
        data-testid="mouse-double-click-status"
        aria-live="polite"
      >
        Double clicks: 0.
      </p>
    </section>

    <section
      id="mouse-context-menu-case"
      class="mouse-case card"
      data-testid="mouse-context-menu-case"
      data-context-count="0"
      data-last-button="none"
    >
      <h2>Right click</h2>
      <p>The native menu is suppressed while the context-menu event is counted.</p>
      <button
        id="mouse-context-menu-target"
        class="mouse-action-target"
        data-testid="mouse-context-menu-target"
        type="button"
        aria-describedby="mouse-context-menu-status"
      >
        Right-click me
      </button>
      <p
        id="mouse-context-menu-status"
        class="mouse-status"
        data-testid="mouse-context-menu-status"
        aria-live="polite"
      >
        Context menus: 0.
      </p>
    </section>
  </div>

  <section class="mouse-event-panel" aria-labelledby="mouse-event-heading">
    <div class="mouse-event-heading">
      <div>
        <h2 id="mouse-event-heading">Event log</h2>
        <p class="muted">Events use monotonic indexes and contain no timestamps or random values.</p>
      </div>
      <button id="mouse-reset" data-testid="mouse-reset" type="button">Reset state</button>
    </div>
    <ol
      id="mouse-event-log"
      class="scenario-log mouse-event-log"
      data-testid="mouse-event-log"
      data-entry-count="0"
      aria-label="Mouse event log"
    >
      <li data-testid="mouse-log-empty">No mouse events recorded.</li>
    </ol>
  </section>
</BaseLayout>
