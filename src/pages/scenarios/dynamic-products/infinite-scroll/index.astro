---
import dynamicProductsScript from '../../../../assets/dynamic-products.js?url';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Dynamic Products Infinite Scroll"
  description="Client-side infinite scroll pagination from static JSON product pages."
  canonicalPath="/scenarios/dynamic-products/infinite-scroll/"
  scripts={[dynamicProductsScript]}
  mainId="dynamic-products-scenario"
  mainClass="wrap scenario dynamic-products-scenario"
  mainAttributes={{
    'data-testid': 'dynamic-products-scenario',
    'data-scenario': 'dynamic-products',
    'data-case': 'infinite-scroll',
    'data-state': 'idle',
    'data-page': '0',
    'data-loaded-count': '0',
    'data-total-count': '0',
  }}
>
  <h1>Dynamic Products Infinite Scroll</h1>
  <p class="lead">Fetches the first page on load, then appends later pages when the scroll sentinel enters view.</p>
  <div
    id="dynamic-products-status"
    class="scenario-status"
    data-testid="dynamic-products-status"
    data-state="idle"
    aria-live="polite"
  >
    Ready.
  </div>
  <section
    id="dynamic-products-grid"
    class="product-grid"
    data-testid="dynamic-products-grid"
    aria-label="Dynamic products"
  ></section>
  <div
    id="dynamic-products-scroll-sentinel"
    class="scenario-status dynamic-products-scroll-sentinel"
    data-testid="dynamic-products-scroll-sentinel"
    data-complete="false"
    data-loading="false"
    aria-live="polite"
  >
    Waiting for products.
  </div>
  <ul
    id="dynamic-products-log"
    class="scenario-log"
    data-testid="dynamic-products-log"
    aria-label="Dynamic products event log"
  ></ul>
</BaseLayout>
