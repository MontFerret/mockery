---
import dynamicProductsScript from '../../../../assets/dynamic-products.js?url';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Basic Dynamic Products"
  description="Client-side rendered products fetched from static JSON on page load."
  canonicalPath="/scenarios/dynamic-products/basic/"
  scripts={[dynamicProductsScript]}
  mainId="dynamic-products-scenario"
  mainClass="wrap scenario dynamic-products-scenario"
  mainAttributes={{
    'data-testid': 'dynamic-products-scenario',
    'data-scenario': 'dynamic-products',
    'data-case': 'basic',
    'data-state': 'idle',
    'data-page': '0',
    'data-loaded-count': '0',
    'data-total-count': '0',
  }}
>
  <h1>Basic Dynamic Products</h1>
  <p class="lead">Fetches all product JSON on page load, stores it in memory, and paginates client-side without reloads.</p>
  <div
    id="dynamic-products-status"
    class="scenario-status"
    data-testid="dynamic-products-status"
    data-state="idle"
    aria-live="polite"
  >
    Ready.
  </div>
  <section
    id="dynamic-products-grid"
    class="product-grid"
    data-testid="dynamic-products-grid"
    aria-label="Dynamic products"
  ></section>
  <nav
    id="dynamic-products-pagination"
    class="pagination"
    data-testid="pagination"
    aria-label="Product pages"
  ></nav>
  <ul
    id="dynamic-products-log"
    class="scenario-log"
    data-testid="dynamic-products-log"
    aria-label="Dynamic products event log"
  ></ul>
</BaseLayout>
