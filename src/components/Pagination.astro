---
import { withBase } from '../lib/site.js';

const {
  currentPage,
  totalPages,
  basePath = '/scenarios/ecommerce/products/',
  ariaLabel = 'Product pages',
} = Astro.props;
const normalizedBasePath = basePath.endsWith('/') ? basePath : `${basePath}/`;
const pagePath = (page) => page === 1 ? normalizedBasePath : `${normalizedBasePath}page/${page}/`;
const previous = Math.max(1, currentPage - 1);
const next = Math.min(totalPages, currentPage + 1);
---
<nav class="pagination" data-testid="pagination" aria-label={ariaLabel}>
  <a class="page-link previous" data-testid="page-previous" href={withBase(pagePath(previous))}>Previous</a>
  {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
    <a class="page-link" data-testid="page-link" data-pagenum=`${page}` aria-current={page === currentPage ? 'page' : undefined} href={withBase(pagePath(page))}>{page}</a>
  ))}
  <a class="page-link next" data-testid="page-next" href={withBase(pagePath(next))}>Next</a>
</nav>
